generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique(map: "AdminUser_username_key")
  passwordHash String
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("adminuser")
}

model banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  isActive  Boolean  @default(true)

  @@map("banner")
}

model candidate {
  id                             String   @id @default(cuid())
  sbd                            String   @unique(map: "Candidate_sbd_key")
  name                           String
  votes                          Int      @default(0)
  imageUrl                       String
  description                    String   @db.Text
  biography                      String?  @db.Text
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @default(now()) @updatedAt
  advisorName                    String?
  contestTable                   String?
  contestTableLabel              String?
  currentRound                   String?  @default("Vòng loại")
  expectations                   String?  @db.Text
  implementationLocation         String?
  intellectualPropertyCommitment Boolean? @default(false)
  leaderEmail                    String?
  leaderName                     String?
  leaderPhone                    String?
  members                        String?  @db.Text
  representativeSchool           String?
  status                         String?  @default("Đủ hồ sơ")
  supportNeeds                   String?  @db.Text
  teamName                       String?
  sector                         String?
  showcaseImages                 String?  @db.Text

  @@map("candidate")
}

model post {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique(map: "Post_slug_key")
  summary      String?  @db.Text
  content      String   @db.Text
  thumbnailUrl String?
  isActive     Boolean  @default(true)
  category     String   @default("Tin tức")
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model sponsor {
  id            String       @id @default(cuid())
  name          String
  logoUrl       String
  tier          sponsor_tier @default(PARTNER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  contactPerson String?
  description   String?      @db.Text
  email         String?
  phone         String?
  websiteUrl    String?

  @@map("sponsor")
}

model TimelineEvent {
  id          String   @id @default(cuid())
  date        String
  title       String
  description String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  isImportant Boolean  @default(false)
  round       String   @default("Vòng loại")

  @@map("timelineevent")
}

model VoteRecord {
  id            String   @id @default(cuid())
  candidateId   String
  voterPhone    String
  voteTime      DateTime @default(now())
  transactionId String?

  @@map("voterecord")
}

model PageView {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  referrer  String?  @db.Text
  userAgent String?  @db.Text
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([path])
  @@index([createdAt])
  @@map("pageview")
}

model WebUser {
  id              String   @id @default(cuid())
  fullName        String
  email           String   @unique(map: "WebUser_email_key")
  phone           String?
  passwordHash    String?
  provider        String   @default("email")
  role            String   @default("USER")
  status          String   @default("ACTIVE")
  schoolOrCompany String?
  contestTable    String?
  registeredAt    DateTime @default(now())
  lastLoginAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@map("webuser")
}

enum sponsor_tier {
  PLATINUM
  GOLD
  SILVER
  PARTNER
}
