generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique(map: "AdminUser_username_key")
  passwordHash String
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("adminuser")
}

model banner {
  id        String    @id @default(cuid())
  title     String
  titleEn   String?
  imageUrl  String
  link      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@map("banner")
}

model candidate {
  id                             String    @id @default(cuid())
  sbd                            String    @unique(map: "Candidate_sbd_key")
  name                           String
  votes                          Int       @default(0)
  imageUrl                       String
  description                    String    @db.Text
  descriptionEn                  String?   @db.Text
  biography                      String?   @db.Text
  biographyEn                    String?   @db.Text
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @default(now()) @updatedAt
  advisorName                    String?
  contestTable                   String?
  contestTableLabel              String?
  currentRound                   String?   @default("Vòng loại")
  expectations                   String?   @db.Text
  implementationLocation         String?
  intellectualPropertyCommitment Boolean?  @default(false)
  leaderEmail                    String?
  leaderName                     String?
  leaderPhone                    String?
  members                        String?   @db.Text
  representativeSchool           String?
  status                         String?   @default("Đủ hồ sơ")
  supportNeeds                   String?   @db.Text
  teamName                       String?
  sector                         String?
  showcaseImages                 String?   @db.Text
  isDeleted                      Boolean   @default(false)
  deletedAt                      DateTime?

  @@map("candidate")
}

model CandidateRegistration {
  id                    String    @id @default(cuid())
  fullName              String
  gender                String
  dateOfBirth           DateTime?
  major                 String
  className             String
  studentId             String
  placeOfBirth          String
  identityNumber        String
  identityIssuedDate    DateTime?
  identityIssuedPlace   String
  address               String    @db.Text
  phone                 String
  email                 String
  facebookUrl           String?
  talent                String?   @db.Text
  selfIntroduction      String?   @db.Text
  inspirationalMessage  String?   @db.Text
  facultyIntroduction   String?   @db.Text
  ambassadorPlan        String?   @db.Text
  portraitImageUrl      String
  fullBodyImageUrl      String
  heightCm              Decimal?  @db.Decimal(5, 2)
  weightKg              Decimal?  @db.Decimal(5, 2)
  measurementBust       Decimal?  @db.Decimal(5, 2)
  measurementWaist      Decimal?  @db.Decimal(5, 2)
  measurementHip        Decimal?  @db.Decimal(5, 2)
  status                String    @default("PENDING")
  adminNote             String?   @db.Text
  consentAccepted       Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("candidateregistration")
}

model post {
  id           String    @id @default(cuid())
  title        String
  titleEn      String?
  slug         String    @unique(map: "Post_slug_key")
  summary      String?   @db.Text
  summaryEn    String?   @db.Text
  content      String    @db.Text
  contentEn    String?   @db.Text
  thumbnailUrl String?
  isActive     Boolean   @default(true)
  category     String    @default("Tin tức")
  views        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?

  @@map("post")
}

model sponsor {
  id            String       @id @default(cuid())
  name          String
  logoUrl       String
  tier          sponsor_tier @default(PARTNER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  contactPerson String?
  description   String?      @db.Text
  descriptionEn String?      @db.Text
  email         String?
  phone         String?
  websiteUrl    String?
  isDeleted     Boolean      @default(false)
  deletedAt     DateTime?

  @@map("sponsor")
}

model TimelineEvent {
  id            String    @id @default(cuid())
  date          String
  title         String
  titleEn       String?
  description   String    @db.Text
  descriptionEn String?   @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  isImportant   Boolean   @default(false)
  round         String    @default("Vòng loại")
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?

  @@map("timelineevent")
}

model VoteRecord {
  id            String   @id @default(cuid())
  candidateId   String
  voterPhone    String
  voteTime      DateTime @default(now())
  transactionId String?
  ipHash        String?
  deviceHash    String?
  riskScore     Int      @default(0)
  riskReason    String?  @db.Text

  @@index([ipHash])
  @@index([deviceHash])
  @@index([voteTime])
  @@map("voterecord")
}

model PageView {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  referrer  String?  @db.Text
  userAgent String?  @db.Text
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([path])
  @@index([createdAt])
  @@map("pageview")
}

model WebUser {
  id              String    @id @default(cuid())
  fullName        String
  email           String    @unique(map: "WebUser_email_key")
  phone           String?
  passwordHash    String?
  provider        String    @default("email")
  role            String    @default("USER")
  status          String    @default("ACTIVE")
  schoolOrCompany String?
  contestTable    String?
  registeredAt    DateTime  @default(now())
  lastLoginAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  @@map("webuser")
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("passwordresetcode")
}

model SystemSetting {
  id        String   @id @default("default")
  data      String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt

  @@map("systemsetting")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminUser  String   @default("admin")
  action     String
  targetType String
  targetId   String?
  targetName String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([targetType])
  @@index([createdAt])
  @@map("adminauditlog")
}

model ApiErrorLog {
  id         String   @id @default(cuid())
  method     String
  path       String
  statusCode Int
  message    String   @db.Text
  stack      String?  @db.Text
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode])
  @@index([path])
  @@map("apierrorlog")
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String    @db.Text
  type      String    @default("INFO")
  isActive  Boolean   @default(true)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([isActive, startsAt])
  @@map("notification")
}

model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@map("supportticket")
}

enum sponsor_tier {
  PLATINUM
  GOLD
  SILVER
  PARTNER
}
